# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.so
*.pyo

# ── Build / packaging ─────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Secrets & local config ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ── Type checkers & linters ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/

# ── Data — generated / large binary files ────────────────────────────────────
# Ignore data/ contents, but ship the small standard VRPTW instance geometry
# (Solomon/Homberger .vrp files) the API needs to render maps from a clean clone.
/data/*
!/data/vrptw_instances/
*.parquet
*.log
*.csv

# Ship the canonical evaluation report CSVs (locked by docs/canonical_hashes.txt
# and read by `python -m product.evaluation.verify_reports`) despite *.csv above.
!/product/evaluation/reports/**/*.csv

# Keep small checked-in instance lists
!instances/

# ── Agent config / working files — kept local, not part of the public showcase ─
.claude/
CLAUDE.md

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/

# ── Frontend build ────────────────────────────────────────────────────────────
frontend/dist/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*~

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
prompt.md

# ── D5: local-dev recompute runtime artifacts (not benchmark truth) ──────────
product/api/runtime/

# ── Copilot request telemetry (raw prompts, not for sharing) ─────────────────
/logs/*
!/logs/.gitkeep