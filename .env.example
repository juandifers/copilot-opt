# Copy to .env and fill in. .env is gitignored; .env.example is checked in
# as documentation of which vars the live system expects.

# OpenAI API key — required for LLM-on configurations (the semantic intent
# adapter and the evaluation model client both read this).
# Generate at platform.openai.com -> API keys.
OPENAI_API_KEY=

# Anthropic API key — required only for the Stage A experiment backends
# (experiment/src/backends/api.py). Not needed for product/ or frontend/.
# Generate at console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=
