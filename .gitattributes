# Default: normalise line endings to LF in the repo
* text=auto eol=lf

# Python source
*.py text eol=lf
*.pyi text eol=lf

# Config / markup
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary — never diff or merge
*.parquet binary
*.pkl     binary
*.so      binary
*.pyd     binary
*.pyc     binary
