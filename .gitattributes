# Default: normalise line endings to LF in the repo
* text=auto eol=lf

# Python source
*.py text eol=lf
*.pyi text eol=lf

# Config / markup
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Canonical evaluation report CSVs are byte-locked by docs/canonical_hashes.txt
# (the hashes are over the on-disk CRLF bytes). Disable eol normalisation so a
# clone reproduces the exact bytes and the SHA-256 lock still verifies.
product/evaluation/reports/**/*.csv -text

# Binary — never diff or merge
*.parquet binary
*.pkl     binary
*.so      binary
*.pyd     binary
*.pyc     binary
